# Copy this file to dashboard-oauth.env and keep that local file private.
# Set this exact callback URL in your GitHub OAuth App:
# https://codefactory.utopiklab.com/auth/callback
# Request the GitHub OAuth scope: read:org
# Dashboard access is restricted to the GitHub organization: UtopikPrompt
# Generate DASHBOARD_SESSION_SIGNING_KEY from at least 32 random bytes.
# For example, use: openssl rand -base64 32
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DASHBOARD_SESSION_SIGNING_KEY=