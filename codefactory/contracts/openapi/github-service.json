{
    "openapi": "3.1.0",
    "info": {
        "title": "Codefactory GitHub Service",
        "version": "1.0.0",
        "description": "Signed webhook intake and bearer-authenticated internal GitHub capabilities."
    },
    "paths": {
        "/healthz": {
            "get": {
                "operationId": "healthz",
                "responses": {
                    "200": {
                        "description": "Service health",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/webhooks/github": {
            "post": {
                "operationId": "receiveGitHubWebhook",
                "parameters": [
                    {
                        "name": "x-github-event",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "x-github-delivery",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "x-hub-signature-256",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "description": "Provider webhook payload. Event-specific GitHub fields remain open; the signature covers the raw body.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Delivery accepted, ignored, or already handled",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WebhookResult"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "413": {
                        "$ref": "#/components/responses/PayloadTooLarge"
                    },
                    "500": {
                        "$ref": "#/components/responses/ProcessingFailure"
                    }
                }
            }
        },
        "/internal/events/claim": {
            "post": {
                "operationId": "claimEvent",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Leased event or null when the queue is empty",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ClaimResult"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        },
        "/internal/events/{event_id}/ack": {
            "post": {
                "operationId": "acknowledgeEvent",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EventId"
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/ClaimToken"
                },
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/Acknowledged"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "409": {
                        "$ref": "#/components/responses/InvalidClaim"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        },
        "/internal/events/{event_id}/retry": {
            "post": {
                "operationId": "retryEvent",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EventId"
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/RetryEvent"
                },
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/Retried"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "409": {
                        "$ref": "#/components/responses/InvalidClaim"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        },
        "/internal/github/propose-changes": {
            "post": {
                "operationId": "proposeFileChanges",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/FileChangeProposal"
                },
                "responses": {
                    "200": {
                        "description": "Applied to the deterministic task branch and created or reused its matching pull request. The operation never updates the base branch or merges.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PullRequestResult"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "409": {
                        "$ref": "#/components/responses/ProposalConflict"
                    },
                    "413": {
                        "$ref": "#/components/responses/PayloadTooLarge"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        },
        "/internal/github/source-tree": {
            "post": {
                "operationId": "getTaskSourceTree",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/TaskSourceTree"
                },
                "responses": {
                    "200": {
                        "description": "At most 200 safe candidate paths from the task repository's current default-branch tree. Repository and installation are resolved only from GitHub-owned task context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskSourceTree"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "409": {
                        "$ref": "#/components/responses/ProposalConflict"
                    },
                    "413": {
                        "$ref": "#/components/responses/PayloadTooLarge"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        },
        "/internal/github/source-files": {
            "post": {
                "operationId": "getTaskSourceFiles",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/TaskSourceFiles"
                },
                "responses": {
                    "200": {
                        "description": "At most six requested regular text files from the task's current default-branch tree, with 16 KiB per-file and 64 KiB aggregate limits.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskSourceFiles"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "409": {
                        "$ref": "#/components/responses/ProposalConflict"
                    },
                    "413": {
                        "$ref": "#/components/responses/PayloadTooLarge"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        },
        "/internal/github/complete-task": {
            "post": {
                "operationId": "completeTask",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/TaskId"
                },
                "responses": {
                    "200": {
                        "description": "Completion decision and the open GitHub update payload when completed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompletionResult"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "503": {
                        "$ref": "#/components/responses/Unavailable"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "parameters": {
            "EventId": {
                "name": "event_id",
                "in": "path",
                "required": true,
                "schema": {
                    "type": "string"
                }
            }
        },
        "requestBodies": {
            "ClaimToken": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "claim_token"
                            ],
                            "properties": {
                                "claim_token": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "RetryEvent": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "claim_token",
                                "error"
                            ],
                            "properties": {
                                "claim_token": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "error": {
                                    "type": "string",
                                    "description": "The service truncates stored error text to 2000 characters."
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "FileChangeProposal": {
                "required": true,
                "description": "The raw JSON request body is limited to 2 MiB. UTF-8 file content is limited to 64 KiB per file and 256 KiB total.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "task_id",
                                "changes"
                            ],
                            "properties": {
                                "task_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 256
                                },
                                "summary": {
                                    "type": "string",
                                    "maxLength": 1200,
                                    "description": "Implementation summary included in the pull request description when risk_summary is also provided."
                                },
                                "risk_summary": {
                                    "type": "string",
                                    "maxLength": 1600,
                                    "description": "Advisory risk summary for human review; it does not add a gate."
                                },
                                "changes": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 20,
                                    "items": {
                                        "$ref": "#/components/schemas/FileChange"
                                    },
                                    "description": "UTF-8 content is limited to 64 KiB per file and 256 KiB total."
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            },
            "TaskSourceTree": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "task_id"
                            ],
                            "properties": {
                                "task_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 256
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            },
            "TaskSourceFiles": {
                "required": true,
                "description": "The raw request body is limited to 8 KiB.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "task_id",
                                "paths"
                            ],
                            "properties": {
                                "task_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 256
                                },
                                "paths": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 6,
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 240
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            },
            "TaskId": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "task_id"
                            ],
                            "properties": {
                                "task_id": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "schemas": {
            "Health": {
                "type": "object",
                "required": [
                    "status"
                ],
                "properties": {
                    "status": {
                        "const": "ok"
                    }
                },
                "additionalProperties": false
            },
            "WebhookResult": {
                "type": "object",
                "required": [
                    "status",
                    "delivery_id"
                ],
                "properties": {
                    "status": {
                        "enum": [
                            "queued",
                            "ignored",
                            "duplicate",
                            "in_progress"
                        ]
                    },
                    "delivery_id": {
                        "type": "string"
                    },
                    "event_count": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "event_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "additionalProperties": false
            },
            "ClaimResult": {
                "type": "object",
                "required": [
                    "event"
                ],
                "properties": {
                    "event": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/ClaimedEvent"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "additionalProperties": false
            },
            "ClaimedEvent": {
                "type": "object",
                "required": [
                    "event_id",
                    "delivery_id",
                    "claim_token",
                    "attempt",
                    "payload"
                ],
                "properties": {
                    "event_id": {
                        "type": "string"
                    },
                    "delivery_id": {
                        "type": "string"
                    },
                    "claim_token": {
                        "type": "string"
                    },
                    "attempt": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "payload": {
                        "oneOf": [
                            {
                                "$ref": "../events/v1/ready.json"
                            },
                            {
                                "$ref": "../events/v1/ci.json"
                            },
                            {
                                "$ref": "../events/v1/merged.json"
                            }
                        ]
                    }
                },
                "additionalProperties": false
            },
            "PullRequestResult": {
                "type": "object",
                "required": [
                    "pull_request_id",
                    "repository",
                    "number"
                ],
                "properties": {
                    "pull_request_id": {
                        "type": "string"
                    },
                    "repository": {
                        "type": "string"
                    },
                    "number": {
                        "type": "integer"
                    },
                    "url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "additionalProperties": true
            },
            "FileChange": {
                "type": "object",
                "required": [
                    "operation",
                    "path",
                    "content"
                ],
                "properties": {
                    "operation": {
                        "type": "string",
                        "enum": [
                            "create",
                            "update"
                        ]
                    },
                    "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "description": "Relative repository file path. Absolute paths, traversal, backslashes, controls, duplicate/case-colliding paths, and credential/private-key files are rejected."
                    },
                    "content": {
                        "type": "string",
                        "maxLength": 65536,
                        "description": "UTF-8 text content; NUL bytes are rejected."
                    }
                },
                "additionalProperties": false
            },
            "TaskSourceTree": {
                "type": "object",
                "required": [
                    "paths"
                ],
                "properties": {
                    "paths": {
                        "type": "array",
                        "maxItems": 200,
                        "items": {
                            "$ref": "#/components/schemas/TaskSourcePath"
                        }
                    }
                },
                "additionalProperties": false
            },
            "TaskSourcePath": {
                "type": "object",
                "required": [
                    "path",
                    "size"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16384
                    }
                },
                "additionalProperties": false
            },
            "TaskSourceFiles": {
                "type": "object",
                "required": [
                    "files"
                ],
                "properties": {
                    "files": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                            "$ref": "#/components/schemas/TaskSourceFile"
                        }
                    }
                },
                "additionalProperties": false
            },
            "TaskSourceFile": {
                "type": "object",
                "required": [
                    "path",
                    "content"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                    },
                    "content": {
                        "type": "string",
                        "maxLength": 16384
                    }
                },
                "additionalProperties": false
            },
            "CompletionResult": {
                "oneOf": [
                    {
                        "type": "object",
                        "required": [
                            "completed",
                            "reason"
                        ],
                        "properties": {
                            "completed": {
                                "const": false
                            },
                            "reason": {
                                "enum": [
                                    "task_mapping_unavailable",
                                    "task_mapping_invalid",
                                    "merge_or_checks_unverified"
                                ]
                            }
                        },
                        "additionalProperties": true
                    },
                    {
                        "type": "object",
                        "required": [
                            "completed",
                            "project_update"
                        ],
                        "properties": {
                            "completed": {
                                "const": true
                            },
                            "project_update": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            }
        },
        "responses": {
            "Acknowledged": {
                "description": "Event acknowledged",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "acknowledged"
                            ],
                            "properties": {
                                "acknowledged": {
                                    "const": true
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            },
            "Retried": {
                "description": "Event retry scheduled",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "retried"
                            ],
                            "properties": {
                                "retried": {
                                    "const": true
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            },
            "BadRequest": {
                "description": "Request is invalid",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "Unauthorized": {
                "description": "Signature or bearer authentication failed",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "InvalidClaim": {
                "description": "The event claim is no longer valid",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "ProposalConflict": {
                "description": "Task is not active or existing branch/pull-request state does not match the GitHub-owned task identity.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "Unavailable": {
                "description": "Internal API capability is unavailable",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "PayloadTooLarge": {
                "description": "Webhook body exceeds the configured byte limit",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "ProcessingFailure": {
                "description": "Webhook processing failed",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "detail"
                            ],
                            "properties": {
                                "detail": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    }
}