{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Pull request merged event",
    "type": "object",
    "required": [
        "task_id",
        "event_type",
        "event_pull_request_id",
        "merged",
        "installation_id",
        "webhook_delivery_id"
    ],
    "examples": [
        {
            "task_id": "PVTI_item",
            "event_type": "merged",
            "event_pull_request_id": "9001",
            "merged": true,
            "installation_id": 654,
            "webhook_delivery_id": "delivery-3"
        }
    ],
    "properties": {
        "task_id": {
            "type": "string"
        },
        "event_type": {
            "const": "merged"
        },
        "event_pull_request_id": {
            "type": "string"
        },
        "merged": {
            "type": "boolean"
        },
        "installation_id": {
            "type": "integer",
            "minimum": 1
        },
        "webhook_delivery_id": {
            "type": "string"
        }
    },
    "additionalProperties": true
}