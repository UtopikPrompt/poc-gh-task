{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Ready task event",
    "type": "object",
    "required": [
        "task_id",
        "task_status",
        "event_type",
        "target_repositories",
        "issue",
        "project_node_id",
        "project_item_id",
        "installation_id",
        "webhook_delivery_id"
    ],
    "properties": {
        "task_id": {
            "type": "string"
        },
        "task_status": {
            "const": "ready"
        },
        "event_type": {
            "const": "ready"
        },
        "target_repositories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "issue": {
            "type": "object",
            "required": [
                "repository"
            ],
            "properties": {
                "repository": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": true
        },
        "project_node_id": {
            "type": "string"
        },
        "project_item_id": {
            "type": "string"
        },
        "installation_id": {
            "type": "integer",
            "minimum": 1
        },
        "webhook_delivery_id": {
            "type": "string"
        }
    },
    "additionalProperties": true
}