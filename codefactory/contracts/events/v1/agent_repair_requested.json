{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Explicit human agent repair request event",
    "type": "object",
    "required": [
        "task_id",
        "event_type",
        "event_pull_request_id",
        "event_head_sha",
        "repair_direction",
        "inline_review_context",
        "review_comment_ids",
        "installation_id",
        "webhook_delivery_id"
    ],
    "examples": [
        {
            "task_id": "PVTI_item",
            "event_type": "agent_repair_requested",
            "event_pull_request_id": "9001",
            "event_head_sha": "abc123",
            "repair_direction": "Revert the unrelated README change.",
            "inline_review_context": {
                "path": "README.md",
                "line": 34,
                "start_line": 28,
                "side": "RIGHT",
                "diff_hunk": "@@ -28,7 +28,7 @@\n-├── source/\n+−── source/"
            },
            "review_comment_ids": [
                "4461111142"
            ],
            "installation_id": 654,
            "webhook_delivery_id": "delivery-5"
        }
    ],
    "properties": {
        "task_id": {
            "type": "string",
            "minLength": 1
        },
        "event_type": {
            "const": "agent_repair_requested"
        },
        "event_pull_request_id": {
            "type": "string",
            "minLength": 1
        },
        "event_head_sha": {
            "type": "string",
            "minLength": 1
        },
        "repair_direction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
        },
        "inline_review_context": {
            "type": "object",
            "required": [
                "path",
                "line",
                "diff_hunk"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                },
                "line": {
                    "type": "integer",
                    "minimum": 1
                },
                "start_line": {
                    "type": "integer",
                    "minimum": 1
                },
                "side": {
                    "enum": [
                        "LEFT",
                        "RIGHT"
                    ]
                },
                "diff_hunk": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                }
            },
            "additionalProperties": false
        },
        "review_comment_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
            }
        },
        "installation_id": {
            "type": "integer",
            "minimum": 1
        },
        "webhook_delivery_id": {
            "type": "string",
            "minLength": 1
        }
    },
    "additionalProperties": true
}