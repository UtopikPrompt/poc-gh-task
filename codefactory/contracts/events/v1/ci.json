{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Pull request CI event",
    "type": "object",
    "required": [
        "task_id",
        "event_type",
        "event_pull_request_id",
        "event_head_sha",
        "ci_checks",
        "ci_complete",
        "installation_id",
        "webhook_delivery_id"
    ],
    "examples": [
        {
            "task_id": "PVTI_item",
            "event_type": "ci",
            "event_pull_request_id": "9001",
            "event_head_sha": "abc123",
            "ci_checks": [
                {
                    "name": "tests",
                    "status": "success"
                }
            ],
            "ci_complete": true,
            "installation_id": 654,
            "webhook_delivery_id": "delivery-2"
        }
    ],
    "properties": {
        "task_id": {
            "type": "string"
        },
        "event_type": {
            "const": "ci"
        },
        "event_pull_request_id": {
            "type": "string"
        },
        "event_head_sha": {
            "type": "string",
            "minLength": 1
        },
        "ci_checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "status"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "enum": [
                            "success",
                            "pending",
                            "failure"
                        ]
                    }
                },
                "additionalProperties": true
            }
        },
        "ci_complete": {
            "type": "boolean",
            "description": "True when the fully queried check set is terminal, including an empty set; an empty set is unavailable CI and is never success."
        },
        "installation_id": {
            "type": "integer",
            "minimum": 1
        },
        "webhook_delivery_id": {
            "type": "string"
        }
    },
    "additionalProperties": true
}